{
  "name": "team-games",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @tg/server dev\" \"pnpm -F @tg/web dev\"",
    "test": "vitest run",
    "build": "pnpm -F @tg/web build && pnpm -F @tg/server build",
    "typecheck": "tsc -b --noEmit packages/shared packages/server packages/web"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "concurrently": "9.1.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
